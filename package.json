{
  "name": "holisticvn",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && node node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:legacy": "node scripts/migrate-legacy.mjs",
    "smoke": "node scripts/smoke-baseline.mjs"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sanity/client": "8.9.0",
    "@sanity/vision": "6.17.0",
    "next": "16.3.8",
    "next-sanity": "13.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.0",
    "sanity": "6.17.0",
    "styled-components": "6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
